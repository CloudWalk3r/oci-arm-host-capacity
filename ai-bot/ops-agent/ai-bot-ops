# Assignments: the project's own code does the work (assign_driver.py), run with the project's Python.
ASSIGNMENTS = HOME / "Assignments"
ASSIGN_DRIVER = Path("/usr/local/lib/ai-bot-ops/assign_driver.py")
ASSIGN_ID = re.compile(r"\d{1,9}")
BASE64URL = re.compile(r"[A-Za-z0-9_-]{1,8000}")


def assignments(*args, stdin=False):
    python = ASSIGNMENTS / ".venv" / "bin" / "python"
    if not (python.exists() and ASSIGN_DRIVER.exists()):
        raise RuntimeError("the Assignments project is not installed on this host")
    # stdin=None hands this process's stdin (the SSH channel) to the driver, which is how the text arrives.
    r = subprocess.run([str(python), str(ASSIGN_DRIVER), *args], stdin=None if stdin else subprocess.DEVNULL,
                       capture_output=True, text=True, timeout=240, cwd=ASSIGNMENTS)
    try:
        return json.loads(r.stdout.strip().splitlines()[-1])
    except (IndexError, ValueError):
        raise RuntimeError(f"assignments: {(r.stderr or r.stdout).strip()[-300:]}") from None


# ---------------------------------------------------------------------------
def main():
    words = os.environ.get("SSH_ORIGINAL_COMMAND", "").split()
    verb, args = (words[0], words[1:]) if words else ("", [])
    try:
        if verb == "health" and not args:
            result = health()
        elif verb == "lantern-status" and not args:
            result = lantern_status()
        elif verb == "lantern-retry" and not args:
            result = lantern_retry()
        elif verb == "autopilot-status" and len(args) <= 1 and all(re.fullmatch(r"\d+(\.\d+)?", a) for a in args):
            result = autopilot_status(*args)
        elif verb in ("autopilot-pause", "autopilot-resume") and len(args) == 1 and args[0] in STREAMS:
            result = autopilot_set(verb.split("-")[1], args[0])
        elif verb == "review-list" and not args:
            result = review_list()
        elif verb == "review-item" and len(args) in (1, 2) and ITEM_ID.fullmatch(args[0]) and all(a in "012345678" for a in args[1:]):
            result = review_item(*args)
        elif verb == "review-lantern" and len(args) == 2 and SLUG.fullmatch(args[0]) and re.fullmatch(r"\d{1,2}", args[1]):
            result = review_lantern(*args)
        elif verb in ("autopilot-block", "autopilot-unblock") and len(args) == 1 and ITEM_ID.fullmatch(args[0]):
            result = autopilot_block(verb.split("-")[1], args[0])
        elif verb == "yt-stats" and not args:
            result = engine(AP_STATS, timeout=120)
        elif verb == "assign-list" and args in ([], ["all"]):
            result = assignments("list", *args)
        elif verb == "assign-brief" and len(args) == 1 and ASSIGN_ID.fullmatch(args[0]):
            result = assignments("brief", args[0])
        elif (verb == "assign-prompt" and len(args) in (2, 3) and ASSIGN_ID.fullmatch(args[0])
              and re.fullmatch(r"\d{4,5}", args[1]) and all(BASE64URL.fullmatch(a) for a in args[2:])):
            result = assignments("prompt", *args)
        elif verb == "assign-build" and len(args) == 1 and ASSIGN_ID.fullmatch(args[0]):
            result = assignments("build", args[0], stdin=True)
        else:
            print(json.dumps({"error": f"not allowed: {' '.join(words)[:80] or '(empty)'}"}))
            return 2
    except Exception as e:  # noqa: BLE001 - every failure goes back to the bot as JSON
        print(json.dumps({"error": str(e)[:500]}))
        return 1
    print(json.dumps(result, default=str))
    return 0


if __name__ == "__main__":
    sys.exit(main())
