def nightly():
    lines = [m.groups() for m in map(NIGHTLY_LINE.match, tail_lines(AUTOPILOT / "nightly.log", 4000)) if m]
    starts = [i for i, (_, msg) in enumerate(lines) if msg.startswith("topic ")]
    info = {"running": sh(["pgrep", "-f", "whiteboard/nightly.sh"], timeout=10)[0] == 0}
    if starts:
        i = starts[-1]
        after = [msg for _, msg in lines[i + 1:]]
        info.update(topic=lines[i][1][6:], started=lines[i][0],
                    queued=any(m.startswith("queued ") for m in after),
                    last=lines[-1][1], last_at=lines[-1][0])
    elif lines:
        info.update(last=lines[-1][1], last_at=lines[-1][0])
    progress = tail_lines(AUTOPILOT / "nightly.log", 1)
    info["progress"] = progress[0][:120] if progress and info["running"] else None
    return info


def autopilot_status(since="0"):
    if not (AUTOPILOT / "docker-compose.yml").exists():
        return {"present": False}
    code, out, err = docker("exec", ENGINE, "python", "-c", AP_STATUS, str(float(since)), timeout=60)
    if code != 0:
        raise RuntimeError(f"autopilot engine not answering: {(err or out).strip()[-300:]}")
    data = json.loads(out.strip().splitlines()[-1])
    code, out, _ = docker("ps", "--no-trunc", "--filter", "name=autopilot-studio-run", "--format", "{{.Names}}\t{{.Command}}\t{{.RunningFor}}")
    data["studio_jobs"] = [dict(zip(("name", "cmd", "running_for"), l.split("\t"))) for l in out.splitlines() if l.strip()]
    data["nightly"] = nightly()
    data["present"] = True
    return data


def autopilot_set(action, stream):
    code, out, err = docker("exec", ENGINE, "python", "-c", AP_SET, action, stream, timeout=60)
    if code != 0:
        raise RuntimeError(f"could not {action} {stream}: {(err or out).strip()[-300:]}")
    return {"ok": True, "message": f"{stream} {action}d"}


