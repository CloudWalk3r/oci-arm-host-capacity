# Review material: what a reviewer needs to judge a video, read-only.
def engine(script, *args, timeout=120):
    """Run a script inside the Autopilot engine container and return the JSON it prints."""
    code, out, err = docker("exec", ENGINE, "python", "-c", script, *args, timeout=timeout)
    if code != 0:
        raise RuntimeError(f"autopilot engine: {(err or out).strip()[-300:]}")
    data = json.loads(out.strip().splitlines()[-1])
    if isinstance(data, dict) and data.get("error"):
        raise RuntimeError(data["error"])
    return data


