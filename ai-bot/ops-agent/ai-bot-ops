def build_error(lines):
    """The line that says why a build stopped: the last output before the Python traceback, skipping render progress."""
    lines = [l.strip() for l in lines if l.strip()]
    tb = max((i for i, l in enumerate(lines) if l.startswith("Traceback (most recent call last)")), default=len(lines))
    for l in reversed(lines[:tb]):
        if not re.match(r"w\d+ \d+/\d+", l):
            return l[:300]
    return lines[-1][:300] if lines else ""


def lantern_status():
    if not (LANTERN / "autorun.py").exists():
        return {"present": False}
    code, out, err = sh(["python3", "autorun.py", "status"], cwd=LANTERN, timeout=60)
    if code != 0:
        raise RuntimeError(f"autorun.py status failed: {(err or out).strip()[-300:]}")
    head, end = json.JSONDecoder().raw_decode(out)
    nxt, posted_recent = [], []
    for line in out[end:].splitlines():
        line = line.strip()
        if line.startswith("next:"):
            nxt.append(re.sub(r"\s+", " ", line[5:]).strip())
    st = json.loads((LANTERN / "status.json").read_text())
    cut = time.time() - 86400
    for p in st.get("posted", []):
        if isinstance(p, dict):
            try:
                if ts(p.get("at", "")) > cut:
                    posted_recent.append(p["part"])
            except ValueError:
                pass
    errors = {}
    for part in head.get("current") or []:
        slug, _, n = part.rpartition(":")
        if re.fullmatch(r"[a-z0-9-]+", slug) and n.isdigit():
            errors[part] = build_error(tail_lines(LANTERN / "logs" / f"{slug}_p{n}.txt", 80))
    last = tail_lines(LANTERN / "logs" / "autorun.log", 1)
    return {
        "present": True, **head, "fails": st.get("fails", {}), "next": nxt[:8], "next_total": len(nxt),
        "posted_24h": posted_recent, "errors": errors, "last_log": last[0] if last else None,
    }


def lantern_retry():
    if not (LANTERN / "autorun.py").exists():
        raise RuntimeError("Lanternlight is not on this host")
    code, out, err = sh(["flock", "-w", "5", "/tmp/lanternlight.lock", "python3", "autorun.py", "retry"],
                        cwd=LANTERN, timeout=60)
    if code != 0:
        return {"ok": False, "message": "a build is running right now; try again after it finishes"}
    return {"ok": True, "message": out.strip()}


