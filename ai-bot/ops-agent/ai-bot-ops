SLUG = re.compile(r"[a-z0-9][a-z0-9-]{0,80}")
ITEM_ID = re.compile(r"[0-9a-f]{8,32}")


def read_json(path):
    with open(path, encoding="utf-8") as f:
        return json.load(f)


def lantern_parts():
    """Built Lanternlight parts in queue order."""
    if not (LANTERN / "queue.json").exists():
        return []
    parts = []
    for slug in read_json(LANTERN / "queue.json").get("stories", []):
        try:
            story = read_json(LANTERN / "stories" / slug / "story.json")
        except (OSError, ValueError):
            continue
        out = LANTERN / "series" / "out" / slug
        for p in story.get("parts", []):
            n = p.get("n")
            meta = out / f"p{n}.json"
            if not (meta.exists() and (out / f"p{n}.mp4").exists()):
                continue
            parts.append({"slug": slug, "part": n, "of": len(story["parts"]), "title": story.get("title"),
                          "name": p.get("name"), "built": int(meta.stat().st_mtime),
                          "posted": (out / f"p{n}_posted.json").exists()})
    return parts


def review_list():
    youtube = engine(AP_ITEMS) if (AUTOPILOT / "docker-compose.yml").exists() else []
    return {"youtube": youtube, "lantern": lantern_parts()}


def review_item(item_id, frames="0"):
    data = engine(AP_ITEM, item_id, str(min(int(frames), 8)), timeout=300)
    episode = data.get("episode") or ""
    if SLUG.fullmatch(episode):
        try:
            data["beats"] = read_json(AUTOPILOT / "studio" / "episodes" / f"{episode}.lines.json").get(data["kind"], [])
        except (OSError, ValueError):
            data["beats"] = []
        try:
            brief = read_json(AUTOPILOT / "studio" / "episodes" / f"{episode}.json")
            data["brief"] = {k: brief.get(k) for k in ("promise", "audience", "assumptions", "facts")}
        except (OSError, ValueError):
            data["brief"] = {}
    return data


def review_lantern(slug, part):
    n = int(part)
    story = read_json(LANTERN / "stories" / slug / "story.json")
    p = next((x for x in story.get("parts", []) if x.get("n") == n), None)
    out = LANTERN / "series" / "out" / slug
    if p is None or not (out / f"p{n}.json").exists():
        raise RuntimeError(f"{slug} part {n} is not built")
    built = read_json(out / f"p{n}.json")
    data = {
        "slug": slug, "part": n, "of": len(story["parts"]), "title": story.get("title"), "premise": story.get("premise"),
        "pov": story.get("pov"), "bible": story.get("bible"),
        "earlier": [{"n": x.get("n"), "name": x.get("name"), "payoff": x.get("payoff"), "cliffhanger": x.get("cliffhanger")}
                    for x in story["parts"] if x.get("n", 0) < n],
        "later": [{"n": x.get("n"), "name": x.get("name")} for x in story["parts"] if x.get("n", 0) > n],
        "this": {k: p.get(k) for k in ("name", "hook_text", "payoff", "cliffhanger", "headline", "comment_prompt",
                                       "caption_question", "search_line", "tags_ig", "tags_fb")},
        "lines": [l.get("text", "") for l in p.get("lines", [])],
        "built": {k: built.get(k) for k in ("duration", "words", "lufs", "caption_fb", "caption_ig")},
        "posted": (out / f"p{n}_posted.json").exists(),
    }
    sheet = out / f"p{n}_sheet.jpg"
    if sheet.exists() and sheet.stat().st_size < 2_000_000:
        import base64
        data["sheet"] = base64.b64encode(sheet.read_bytes()).decode()
    return data


def autopilot_block(action, item_id):
    return engine(AP_BLOCK, action, item_id)


