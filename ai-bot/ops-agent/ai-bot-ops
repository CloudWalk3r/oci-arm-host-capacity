#!/usr/bin/python3
"""Forced command for ai-bot's ops SSH key: runs one allowlisted check or action and prints JSON.

Installed as /usr/local/bin/ai-bot-ops by install.sh and bound to the key in ~/.ssh/authorized_keys:
    command="/usr/local/bin/ai-bot-ops",restrict ssh-ed25519 AAAA... ai-bot-ops
The key can run nothing else; the requested verb arrives in SSH_ORIGINAL_COMMAND.

    health                        uptime, load, memory, disk, containers, updates, failed units
    lantern-status                Lanternlight queue state, parked parts and their last error
    lantern-retry                 clear Lanternlight failure counts (autorun.py retry)
    autopilot-status [SINCE]      guardian status, paused streams, nightly build, events newer than SINCE
    autopilot-pause STREAM        pause a stream (youtube, site, gumroad, newsletter, stock, all)
    autopilot-resume STREAM       resume a stream
    review-list                   YouTube items and built Lanternlight parts that can be reviewed
    review-item ID [FRAMES]       script, facts, title, description, thumbnail and FRAMES sampled stills of a video
    review-lantern SLUG PART      story, narration, captions and contact sheet of one Lanternlight part
    autopilot-block ID            stop a queued item from publishing (a long video takes its Short with it)
    autopilot-unblock ID          put a blocked item back in the queue
    yt-stats                      views, likes and comments per published video (retention when Analytics is enabled)
    assign-list [all]             upcoming assignments and deadlines from the snapshot the PC pushed
    assign-brief ID               the brief of one assignment
    assign-prompt ID CHARS [NOTES]  the task for a model to write it, under CHARS characters (NOTES: base64url)
    assign-build ID               build the .docx from the written text on stdin; returns it as base64
"""
import json
import os
import re
import shutil
import subprocess
import sys
import time
from datetime import datetime, timezone
from pathlib import Path

HOME = Path.home()
LANTERN = HOME / "lanternlight"
AUTOPILOT = HOME / "autopilot"
ENGINE = "autopilot-engine-1"
STREAMS = ("youtube", "site", "gumroad", "newsletter", "stock", "all")
NIGHTLY_LINE = re.compile(r"^(\d{4}-\d\d-\d\dT\d\d:\d\d:\d\dZ) nightly: (.*)$")


def sh(cmd, timeout=60, cwd=None):
    r = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout, cwd=cwd)
    return r.returncode, r.stdout, r.stderr


def docker(*args, timeout=30):
    return sh(["sudo", "-n", "docker", *args], timeout=timeout)


def has_docker():
    return shutil.which("docker") is not None


def tail_lines(path, n, max_bytes=262144):
    try:
        with open(path, "rb") as f:
            f.seek(0, os.SEEK_END)
            f.seek(max(0, f.tell() - max_bytes))
            lines = f.read().decode("utf-8", "replace").splitlines()
    except OSError:
        return []
    return lines[-n:]


def ts(s):
    return datetime.strptime(s, "%Y-%m-%dT%H:%M:%SZ").replace(tzinfo=timezone.utc).timestamp()


# ---------------------------------------------------------------------------
def health():
    mem = {}
    with open("/proc/meminfo") as f:
        for line in f:
            k, v = line.split(":", 1)
            mem[k] = int(v.split()[0]) // 1024
    disk = shutil.disk_usage("/")
    with open("/proc/uptime") as f:
        uptime = float(f.read().split()[0])

    containers = None
    if has_docker():
        containers = []
        code, out, _ = docker("ps", "-aq")
        ids = out.split() if code == 0 else []
        if ids:
            fmt = "{{json .Name}}\t{{.State.Status}}\t{{.RestartCount}}\t{{.State.StartedAt}}\t{{json .Config.Image}}" \
                  "\t{{if .State.Health}}{{.State.Health.Status}}{{end}}\t{{.State.OOMKilled}}\t{{.HostConfig.RestartPolicy.Name}}"
            code, out, _ = docker("inspect", "-f", fmt, *ids)
            for line in out.splitlines() if code == 0 else []:
                name, state, restarts, started, image, hc, oom, policy = line.split("\t")
                containers.append({
                    "name": json.loads(name).lstrip("/"), "state": state, "restarts": int(restarts),
                    "started": started, "image": json.loads(image), "health": hc or None, "oom": oom == "true",
                    # Only containers with a restart policy are meant to stay up; `run --rm` jobs come and go.
                    "managed": policy not in ("", "no"),
                })

    updates = security = None
    if os.path.exists("/usr/lib/update-notifier/apt-check"):
        code, _, err = sh(["/usr/lib/update-notifier/apt-check"], timeout=60)
        m = re.match(r"(\d+);(\d+)", err.strip())
        if m:
            updates, security = int(m.group(1)), int(m.group(2))
    if updates is None:
        code, out, _ = sh(["apt", "list", "--upgradable"], timeout=60)
        updates = sum("upgradable from" in l for l in out.splitlines())

    _, out, _ = sh(["systemctl", "--failed", "--no-legend", "--plain"], timeout=15)
    failed = [l.split()[0] for l in out.splitlines() if l.strip()]

    return {
        "host": os.uname().nodename, "arch": os.uname().machine, "uptime_s": int(uptime),
        "load": [round(x, 2) for x in os.getloadavg()], "cpus": os.cpu_count(),
        "mem_total_mb": mem.get("MemTotal", 0), "mem_avail_mb": mem.get("MemAvailable", 0),
        "swap_total_mb": mem.get("SwapTotal", 0), "swap_used_mb": mem.get("SwapTotal", 0) - mem.get("SwapFree", 0),
        "disk_total_gb": round(disk.total / 1e9, 1), "disk_free_gb": round(disk.free / 1e9, 1),
        "disk_used_pct": round(100 * (disk.total - disk.free) / disk.total, 1),
        "containers": containers, "updates": updates, "security_updates": security,
        "reboot_required": os.path.exists("/var/run/reboot-required"), "failed_units": failed,
    }


