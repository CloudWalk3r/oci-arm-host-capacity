# ╔════════════════════════════════════════════════════════════════════════╗
# ║  ai-bot configuration — copy to .env and fill in your values         ║
# ╚════════════════════════════════════════════════════════════════════════╝

# ── Telegram ──────────────────────────────────────────────────────────
# Create a bot with @BotFather and paste the token here.
TELEGRAM_BOT_TOKEN=

# Comma-separated numeric Telegram user IDs allowed to use this bot.
# Get yours from @userinfobot. Leave empty to allow everyone (NOT recommended).
ALLOWED_USER_IDS=

# ── AI providers (set at least one) ───────────────────────────────────
# Groq — https://console.groq.com (free tier, fast inference)
GROQ_API_KEY=

# Google Gemini — https://aistudio.google.com/apikey
GEMINI_API_KEY=

# GitHub Models — a GitHub PAT with the "models" scope
# https://github.com/settings/tokens
GITHUB_MODELS_TOKEN=
# Currently gated off (returns "OK" placeholder). Set to 1 once working.
GITHUB_MODELS_ENABLED=

# ── Image generation (/image) ────────────────────────────────────────
# Uses Gemini. Free tier has zero image quota (returns 429).
# Set to 1 once you have a billed Gemini key with image generation access.
IMAGE_ENABLED=
# IMAGE_MODEL=gemini-2.5-flash-image

# ── Local Ollama (optional, for private on-device models) ────────────
# Point to your Ollama instance. Default assumes an ARM box on a VCN.
OLLAMA_BASE_URL=http://10.0.1.55:11434/v1

# ── Server ops (/servers /autopilot /lantern + alerts) ───────────────
# The bot checks each instance over SSH with a dedicated key that can only run
# the ai-bot-ops agent. One-time setup on the bot's host:
#   mkdir ops-ssh && ssh-keygen -t ed25519 -N '' -C ai-bot-ops -f ops-ssh/id_ed25519
#   ssh-keyscan -t ed25519 <each address below> > ops-ssh/known_hosts
#   sudo chown -R 1000:1000 ops-ssh data
# then on every instance: sh ops-agent/install.sh "$(cat ops-ssh/id_ed25519.pub)"
# Leave OPS_HOSTS empty to turn server ops off.
# name=address pairs; use private (VCN) addresses.
OPS_HOSTS=micro1=10.0.1.40,micro2=10.0.1.116,arm1=10.0.1.123,arm2=10.0.1.55
# Which of those hosts runs Lanternlight and Autopilot.
OPS_LANTERN_HOST=arm1
OPS_AUTOPILOT_HOST=arm1
# How often to check for problems (minutes), and where alerts go
# (default: the lowest ID in ALLOWED_USER_IDS).
OPS_ALERT_MINUTES=10
# OPS_ALERT_CHAT_ID=
# Alert thresholds.
# OPS_DISK_ALERT_PCT=85
# OPS_MEM_ALERT_PCT=8
# OPS_LANTERN_BLOCKED_HOURS=3

# ── Video reviews (/review /audit /ytstats) ──────────────────────────
# Feedback on Autopilot's YouTube videos and Lanternlight reels before they go
# out. /review lists what is not posted yet and a video is reviewed only when
# it is picked there; nothing is sent unasked except the weekly channel
# numbers (Monday morning, to the alert chat). Needs server ops (above) plus
# GROQ_API_KEY or GEMINI_API_KEY; thumbnails and frames are checked with Gemini.
# REVIEW_ENABLED=1
# How many of the next unposted Lanternlight parts /review lists (0 = none).
# REVIEW_LANTERN_AHEAD=6
# Times in review messages: minutes ahead of UTC (330 = Sri Lanka).
# REVIEW_UTC_OFFSET_MINUTES=330
# provider:model lists, tried in order (providers: groq, gemini).
# REVIEW_TEXT_MODELS=groq:openai/gpt-oss-120b,gemini:gemini-3.5-flash,gemini:gemini-flash-lite-latest
# REVIEW_VISION_MODELS=gemini:gemini-3.5-flash,gemini:gemini-flash-latest,gemini:gemini-flash-lite-latest

# ── Assignments (/assignments /brief /write) ─────────────────────────
# Lists coursework that is due, shows a brief, writes an assignment as a
# Word document and sends a daily update to the alert chat. Needs server ops
# (above) and the Assignments project installed on one of those hosts in
# ~/Assignments with its own .venv. That server holds no LMS login: the PC
# syncs with the LMS and pushes a snapshot (`assignments.py sync --push`).
# The text is written by the bot's own models: the one chosen in /model
# first, so the brief and course material go to that provider.
# Leave ASSIGN_HOST empty to turn assignments off.
ASSIGN_HOST=arm2
# Daily update: sent after the first sync of the day once it is this time,
# or at the latest time with the data there is. Times are in the Assignments
# project's TIMEZONE. "off" disables the update.
# ASSIGN_DIGEST_TIME=07:00
# ASSIGN_DIGEST_LATEST=10:00
# How often to look for a new snapshot (minutes).
# ASSIGN_CHECK_MINUTES=15
# Models tried after the chat's own, in order (keys from /model).
# ASSIGN_MODELS=groq-gptoss120b,gemini-pro,gpt-4o,gemini-flash,groq-gptoss20b,qwen-coder

# ── Game deals & price alerts (/deals /watch) ────────────────────────
# ISO country code for Steam regional pricing (US, IN, LK, GB, DE, …)
STEAM_CC=US

# IsThereAnyDeal (optional, free) — adds ~35 stores with local currency.
# https://isthereanydeal.com/apps/my/
# Without it, /deals uses CheapShark (USD only).
ITAD_API_KEY=
ITAD_COUNTRY=US

# How often to recheck price watches (hours). Default: 12.
WATCH_INTERVAL_HOURS=12
WATCHES_FILE=data/watches.json

# ── Default AI model ─────────────────────────────────────────────────
# Options: groq-gptoss120b, groq-gptoss20b, groq-qwen27b, gemini-flash,
#          gemini-pro, gpt-4o, gpt-4o-mini, qwen-coder, llama3.2
DEFAULT_MODEL=groq-gptoss120b

# ── Large-file downloads → Telegram (/dl) ────────────────────────────
# Downloads from FuckingFast / DataNodes / FileKeeper via JDownloader 2,
# then uploads to your Telegram chat. Files can be multi-GB, so uploading
# needs a LOCAL Telegram Bot API server (public API caps at 50 MB).

# Step 1: Telegram API credentials for the local Bot API server.
#          Create an app at https://my.telegram.org → "API development tools".
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Step 2: Point to the local Bot API server (the compose service name).
#          Leave BLANK to use the public API (50 MB upload cap).
TELEGRAM_BOT_API_BASE=http://telegram-bot-api:8081

# Step 3: MyJDownloader account — https://my.jdownloader.org
#          The JDownloader container auto-connects with these on startup.
MYJD_EMAIL=
MYJD_PASSWORD=
MYJD_DEVICE=JDownloader@oci

# Shared volume paths (as seen inside each container).
# Both map to the same host ./downloads folder in docker-compose.
DOWNLOAD_DIR=/downloads
JD_OUTPUT_DIR=/output

# Max file size the bot will try to upload (MB).
# Local Bot API: up to 2000. Public API: up to 49. Auto-clamped if too high.
DL_MAX_FILE_MB=2000

# Upload timeout in seconds (for very large files via local Bot API).
# DL_SEND_TIMEOUT=3600
