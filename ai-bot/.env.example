# ===== Telegram =====
# From @BotFather (/newbot)
TELEGRAM_BOT_TOKEN=

# Comma-separated numeric Telegram user IDs allowed to use the bot (from @userinfobot).
# Leave empty to allow everyone (NOT recommended).
ALLOWED_USER_IDS=

# ===== Hosted providers (free tiers; set at least one) =====
# https://console.groq.com
GROQ_API_KEY=
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GitHub Models: a GitHub PAT with the "models" permission. https://github.com/settings/tokens
GITHUB_MODELS_TOKEN=
# GitHub Models endpoint currently returns a placeholder "OK"; set to 1 to re-enable once it works.
GITHUB_MODELS_ENABLED=

# ===== Image generation (/image via Gemini) =====
# Gemini's free tier grants no image-generation quota (returns HTTP 429). /image is off by
# default; set IMAGE_ENABLED=1 once you have a billed Gemini key with image quota.
IMAGE_ENABLED=
# IMAGE_MODEL=gemini-2.5-flash-image

# ===== Local Ollama (on the ARM box, private VCN IP) =====
OLLAMA_BASE_URL=http://10.0.1.21:11434/v1

# ===== /deals (game prices) =====
# Steam/ITAD region: ISO COUNTRY codes, not currency codes (US, IN=India, LK=Sri Lanka).
STEAM_CC=US
# Optional, free: https://isthereanydeal.com/apps/my/ - adds ~35 authorized stores with
# local-currency prices. Without it, /deals uses CheapShark (USD, authorized stores only).
ITAD_API_KEY=
ITAD_COUNTRY=US
# /watch price-drop alerts: how often to recheck, and where to store watches.
WATCH_INTERVAL_HOURS=12
WATCHES_FILE=data/watches.json

# Default model key (see MODELS in bot.py): groq-gptoss120b | gemini-flash | gpt-4o | qwen-coder | llama3.2
DEFAULT_MODEL=groq-gptoss120b

# ===== Large-file downloads -> Telegram (/dl) =====
# Downloads from FuckingFast / DataNodes / FileKeeper via JDownloader 2, then uploads to
# Telegram. These files are multi-GB, so sending them needs a LOCAL Bot API server
# (the public api.telegram.org caps bot uploads at 50 MB; a local server allows up to 2 GB).

# Telegram API credentials for the local Bot API server. Create an app at
# https://my.telegram.org -> "API development tools".
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Where the bot reaches the local Bot API server (the compose service name). Leave BLANK to
# fall back to public api.telegram.org (then /dl is limited to 50 MB files).
TELEGRAM_BOT_API_BASE=http://telegram-bot-api:8081

# MyJDownloader account (https://my.jdownloader.org). The headless JDownloader container
# signs in with these on start and registers itself under MYJD_DEVICE.
MYJD_EMAIL=
MYJD_PASSWORD=
MYJD_DEVICE=JDownloader@oci

# Shared download directory as seen by the BOT + Bot API server containers, and as seen by
# the JDownloader container. Both map to the same host ./downloads folder.
DOWNLOAD_DIR=/downloads
JD_OUTPUT_DIR=/output
# Largest file (MB) the bot will try to send. Local Bot API server supports up to 2000.
DL_MAX_FILE_MB=2000
